{
  "name": "multi-ai-desktop",
  "version": "1.0.0",
  "description": "A standalone workspace for ChatGPT, Claude, and Gemini",
  "main": "main.js",
  "author": "udikaz-cloud",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.kramer.aiworkspace",
    "productName": "AI Workspace",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "styles.css",
      "assets/**/*",
      "scripts/**/*"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "icon": "assets/icons/ai-workspace.icns",
      "category": "public.app-category.productivity",
      "identity": null
    },
    "dmg": {
      "title": "AI Workspace",
      "icon": "assets/icons/ai-workspace.icns",
      "iconSize": 128,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 180,
          "type": "file"
        },
        {
          "x": 400,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icons/ai-workspace.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icons/ai-workspace.ico",
      "uninstallerIcon": "assets/icons/ai-workspace.ico",
      "installerHeaderIcon": "assets/icons/ai-workspace.ico",
      "shortcutName": "AI Workspace",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^4.0.1"
  }
}
